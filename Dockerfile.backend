# Stage 1: Builder
FROM python:3.11-bookworm as builder

WORKDIR /app

# Installer les dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copier requirements.txt et installer les dépendances Python
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-bookworm

WORKDIR /app

# Installer les dépendances système nécessaires à l'exécution + PowerShell
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    gnupg \
    libssl3 \
    && wget -q https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends powershell wixl \
    && rm -rf /var/lib/apt/lists/* /tmp/packages-microsoft-prod.deb

# Copier les dépendances Python du builder
COPY --from=builder /root/.local /root/.local

# Définir le chemin pour les dépendances Python
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1

# Copier le code de l'application
COPY . .

# Exposer le port
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/health')" || exit 1

# Commande de démarrage
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
