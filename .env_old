# Configuration du serveur
HOST=0.0.0.0
PORT=8000
ENV=development
LOG_LEVEL=INFO

# Configuration CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:8000,http://127.0.0.1:8080

# Configuration Rate Limiting
# ENROLL: Limite l'enregistrement des nouveaux agents
ENROLL_RATE_LIMIT=5
ENROLL_WINDOW_SECONDS=3600

# BEACON: Limite les heartbeats (requêtes fréquentes)
BEACON_RATE_LIMIT=100
BEACON_WINDOW_SECONDS=3600

# RESULTS: Limite les soumissions de résultats
RESULTS_RATE_LIMIT=50
RESULTS_WINDOW_SECONDS=3600

# Configuration MongoDB
# URL de connexion MongoDB (local ou distant)
MONGODB_URL=mongodb://localhost:27017
# Nom de la base de données
MONGODB_DB=c2_server
# Timeout de connexion en millisecondes
MONGODB_TIMEOUT=5000
# Mode: 'mongodb' (persistent) ou 'memory' (développement)
DATABASE_MODE=memory

ENCRYPTION_KEY='test-key-32-characters-minimum-here'
CSRF_SECRET_KEY='test-csrf-secret-key-32-chars-minimum'
ADMIN_SECRET_KEY='test-admin-secret-key-32-chars-minimum'
MAX_PAYLOAD_SIZE=10485760
