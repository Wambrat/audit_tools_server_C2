# ===== MongoDB Configuration =====
# Credentials for MongoDB root user
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me_to_secure_password
MONGO_INITDB_DATABASE=jadus_server_db

# ===== Database Configuration =====
# Mode: 'mongodb' for persistent storage, 'memory' for development
DATABASE_MODE=mongodb
# MongoDB connection string with TLS
# Note: TLS certificates must be generated with generate-certs.ps1
MONGODB_URI=mongodb://root:change_me_to_secure_password@mongodb:27017/jadus_server_db?authSource=admin&tls=true&tlsCAFile=/etc/mongodb/ca.pem
MONGODB_TLS_ENABLED=true
MONGODB_TLS_CA_FILE=/etc/mongodb/ca.pem

# ===== Backend Configuration =====
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Secret key for signing (generate a strong random string)
# Example: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_this_to_random_string_at_least_32_chars
# Debug mode (true/false) - NEVER use true in production
DEBUG=false
# Server host and port
HOST=0.0.0.0
PORT=8000

# ===== CORS Configuration =====
# Allowed origins for cross-origin requests (now HTTPS via Traefik)
# Format: "https://domain1,https://domain2"
ALLOWED_ORIGINS=["https://localhost", "https://127.0.0.1"]

# ===== JWT Configuration =====
# Algorithm for JWT signing
JWT_ALGORITHM=HS256
# Token expiration time in hours
JWT_EXPIRATION_HOURS=24
# Admin credentials for login (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ===== Rate Limiting =====
# Enrollment endpoint limits
ENROLL_RATE_LIMIT=5
ENROLL_WINDOW_SECONDS=3600
# Beacon endpoint limits (can be higher)
BEACON_RATE_LIMIT=7200
BEACON_WINDOW_SECONDS=3600
# Results submission limits
RESULTS_RATE_LIMIT=50
RESULTS_WINDOW_SECONDS=3600
# Admin login limits
ADMIN_LOGIN_LIMIT=5
ADMIN_LOGIN_WINDOW_SECONDS=3600

# ===== Logging & Audit Configuration =====
# Enable audit logging (true/false)
AUDIT_LOG_ENABLED=true
# Use structured JSON logging (true/false)
STRUCTURED_LOGGING=true
# Max payload size in bytes (10 MB default)
MAX_PAYLOAD_SIZE=10485760
# Log file location
LOG_FILE=/app/logs/jadus-server.log

# ===== Traefik Configuration =====
# Reverse proxy for HTTPS (Traefik)
TRAEFIK_ENABLED=true
TRAEFIK_DASHBOARD=false
# TLS certificates are located in ./certs/ (must be generated)
# Default: self-signed certs generated by generate-certs.ps1

# ===== Environment =====
# Environment: 'development', 'staging', 'production'
ENV=development

